<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="osobniSpravceFinanci.MainPage"
             BackgroundColor="#F5F7FA"
             Title="Přehled"
             Shell.NavBarIsVisible="False">
    
    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20" Margin="0,0,0,20">
            <Button Text="&lt;" BackgroundColor="Transparent" TextColor="#0056B3" FontSize="20" FontAttributes="Bold" />
            <Label Text="Duben 2026" FontSize="22" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center" />
            <Button Text="&gt;" BackgroundColor="Transparent" TextColor="#0056B3" FontSize="20" FontAttributes="Bold" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="End" Margin="0,0,0,15">
            <Button Text="+ Přidat transakci" 
                    BackgroundColor="#0056B3" 
                    TextColor="White" 
                    CornerRadius="8"
                    FontAttributes="Bold"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" x:Name="TransakceList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="White">

                        <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding Nazev}" FontSize="18" FontAttributes="Bold" TextColor="#333333"/>
                                <Label Text="{Binding Kategorie.Nazev, FallbackValue='Kategorie'}" FontSize="14" TextColor="#6C757D"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" Text="{Binding Castka, StringFormat='{0} Kč'}" FontSize="18" FontAttributes="Bold" TextColor="#0056B3" VerticalOptions="Center" Margin="0,0,20,0"/>

                            <Button Grid.Column="2" Text="✎" BackgroundColor="Transparent" TextColor="#28A745" FontSize="20" WidthRequest="40" Padding="0"/>

                            <Button Grid.Column="3" Text="🗑" BackgroundColor="Transparent" TextColor="#DC3545" FontSize="20" WidthRequest="40" Padding="0"/>
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>