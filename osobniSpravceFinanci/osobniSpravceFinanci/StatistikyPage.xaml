<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="osobniSpravceFinanci.StatistikyPage"
             BackgroundColor="#F5F7FA"
             Title="Statistiky"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Statistiky" FontSize="24" FontAttributes="Bold" TextColor="#333333" />

            <Border Stroke="#CED4DA" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="15,5" BackgroundColor="White">
                <Picker x:Name="ObdobiPicker" Title="Vyberte období" TitleColor="#6C757D" TextColor="#0056B3" SelectedIndexChanged="OnObdobiZmeneno">
                    <Picker.Items>
                        <x:String>Tento měsíc</x:String>
                        <x:String>Minulý měsíc</x:String>
                        <x:String>Tento rok</x:String>
                        <x:String>Celá historie</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Border Grid.Column="0" Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="#E8F5E9" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Příjmy" TextColor="#28A745" FontSize="14" HorizontalOptions="Center" />
                        <Label x:Name="PrijmyLabel" Text="0 Kč" TextColor="#28A745" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Padding="15" StrokeShape="RoundRectangle 10" BackgroundColor="#FDEDEC" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Výdaje" TextColor="#DC3545" FontSize="14" HorizontalOptions="Center" />
                        <Label x:Name="VydajeLabel" Text="0 Kč" TextColor="#DC3545" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="15" StrokeShape="RoundRectangle 10" Stroke="LightGray" BackgroundColor="White">
                <HorizontalStackLayout VerticalOptions="Center">
                    <Label Text="Bilance za období:" FontSize="16" TextColor="#6C757D" VerticalOptions="Center"/>
                    <Label x:Name="BilanceLabel" Text="0 Kč" FontSize="20" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <Label Text="Kde utrácíte nejvíce (Výdaje)" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0"/>

            <Border Padding="15" StrokeShape="RoundRectangle 10" Stroke="LightGray" BackgroundColor="White">
                <VerticalStackLayout x:Name="KategorieStatistikyList" Spacing="15">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <BoxView Grid.Column="0" Color="{Binding Barva}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding Nazev}" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding CastkaZobrazeni}" FontSize="14" FontAttributes="Bold" TextColor="#333333" VerticalOptions="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <ProgressBar Grid.Column="0" Progress="{Binding Procenta}" ProgressColor="{Binding Barva}" HeightRequest="8" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding ProcentaZobrazeni}" FontSize="12" TextColor="#6C757D" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>